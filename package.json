{
  "name": "aura-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "A cinematic, voice-first AI assistant dashboard.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/workshop-v1-v5.test.js",
    "test:workshop": "node test/workshop-v1-v5.test.js",
    "check": "node --check server.js && node --check public/app.js",
    "start:all": "node start-all.js",
    "start:all:sh": "./start-all.sh",
    "start:forge": "cd FORGE && pnpm dev",
    "start:sentinel:api": "cd SENTINEL/sentinel/apps/api && uv run uvicorn sentinel_api.main:app --host 0.0.0.0 --port 8000 --reload",
    "start:sentinel:web": "cd SENTINEL/sentinel/apps/web && pnpm dev",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:restart": "docker-compose restart",
    "desktop": "electron desktop/main.js",
    "desktop:dev": "electron desktop/main.js",
    "desktop:dist": "electron-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.13.24",
    "dotenv": "^17.4.2",
    "wikijs": "^6.4.1"
  },
  "devDependencies": {
    "@omniroute/opencode-provider": "^0.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.aura.assistant",
    "productName": "AURA",
    "artifactName": "AURA-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "public/**/*",
      "core/**/*",
      "agents/**/*",
      "audit/**/*",
      "cyber_guardian/**/*",
      "database/**/*",
      "governance/**/*",
      "memory/**/*",
      "sandbox/**/*",
      "tools/**/*",
      "skills/**/*",
      "package.json",
      "node_modules/**/*",
      "desktop/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AURA"
    }
  }
}
